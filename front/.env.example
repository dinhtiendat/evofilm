# .env.example

# Có dùng dữ liệu Mock không (true thì bật MSW và dữ liệu demo cục bộ)
VITE_USE_MOCK=true

# Ví dụ cấu hình API
# VITE_API_URL=https://api.example.com

# Địa chỉ phía sau (dùng khi kết nối trực tiếp), ví dụ:
# VITE_BACKEND_URL=http://127.0.0.1:8000

# API BaseURL (mặc định cùng nguồn /api; nếu cần nối trực tiếp backend, có thể đặt là ${VITE_BACKEND_URL})
# VITE_API_BASE_URL=/api

# Ví dụ cấu hình ứng dụng
# VITE_APP_TITLE=Jellyfish Frontend

