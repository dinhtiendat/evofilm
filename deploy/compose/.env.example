## MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jellyfish
MYSQL_USER=jellyfish
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

## Redis / Celery Broker
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# Nếu cần ghi đè riêng địa chỉ broker hoàn chỉnh, có thể đặt:
# CELERY_BROKER_URL=redis://redis:6379/0

## Backend
# Tùy chọn: nếu cần gọi thật mô hình lớn, hãy cấu hình thêm
# OPENAI_API_KEY=

## RustFS (S3 compatible)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_BUCKET_NAME=jellyfish-assets
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

## Front runtime config (served as /env.js)
# Vì frontend và backend triển khai trên port riêng, trình duyệt cần truy cập địa chỉ backend trên máy host
BACKEND_URL=http://localhost:8000
