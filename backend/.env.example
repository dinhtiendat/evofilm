# Jellyfish Backend - Ví dụ biến môi trường
# Sao chép thành .env rồi chỉnh sửa theo nhu cầu

# Ứng dụng
APP_NAME=Jellyfish API
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# Cơ sở dữ liệu (mặc định SQLite không đồng bộ)
# DATABASE_URL=sqlite+aiosqlite:///./jellyfish.db
# Ví dụ PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/jellyfish
# Ví dụ MySQL (dùng driver aiomysql):
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/jellyfish

# Redis / Celery Broker
# Theo mặc định, nếu không chỉ định riêng CELERY_BROKER_URL, hệ thống sẽ tự động dùng cấu hình Redis dưới đây để ghép:
# redis://[:password@]host:port/db
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
# Nếu cần ghi đè riêng, có thể chỉ định trực tiếp URL broker hoàn chỉnh:
# CELERY_BROKER_URL=redis://localhost:6379/0

# Địa chỉ phía trước CORS (phân tách bằng dấu phẩy)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tạo hình ảnh (dùng cho tác vụ tạo hình ảnh diễn viên/nhân vật/đạo cụ/bối cảnh/trang phục/khung hình phân cảnh)
# IMAGE_API_PROVIDER=openai
# IMAGE_API_BASE_URL=https://example.com/v1/images/generations
# IMAGE_API_KEY=your-image-api-key

# Tạo video (dùng cho các interface như /film/generated_video)
# VIDEO_API_PROVIDER=openai
# VIDEO_API_BASE_URL=https://example.com/v1/videos/generations
# VIDEO_API_KEY=your-video-api-key

# S3 / Lưu trữ đối tượng (tệp tư liệu)
# Nếu dùng AWS S3, có thể điền theo nhu cầu:
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_REGION_NAME=ap-southeast-1
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET_NAME=jellyfish-assets
# Tiền tố thống nhất tùy chọn, tiện cho cách ly theo môi trường/dự án, ví dụ jellyfish/dev
# S3_BASE_PATH=jellyfish/dev
# nếu có CDN/domain tùy chỉnh, có thể cấu hình thành https://cdn.example.com
# S3_PUBLIC_BASE_URL=
